# 小程序请求 Import Service 的地址。开发者工具可用本机地址；真机需填写已备案并加入微信 request 合法域名的 HTTPS 地址。
TARO_APP_IMPORT_API_BASE=http://127.0.0.1:3210

# Import Service 监听端口
PORT=3210

# 允许调用 Import Service 的网页来源，使用英文逗号分隔。不要填写 *。
IMPORT_ALLOWED_ORIGINS=http://127.0.0.1:43179,http://localhost:43179,https://shawn1017.github.io

# Vercel 部署时设为 same-origin，让 H5 调用同一域名下的 /api/import/*。
# TARO_APP_IMPORT_API_BASE=same-origin

# GitHub Pages 可使用 Supabase Edge 网关；访问码仅保存在当前页面内存中，刷新或关闭后自动清除，不写入构建环境或浏览器存储。
# TARO_APP_IMPORT_API_BASE=https://YOUR_PROJECT_REF.supabase.co/functions/v1/vercel-gateway

# Supabase 仅用于保存 10 分钟有效的图片中转令牌；service role key 只能放在服务端环境变量。
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SECRET
