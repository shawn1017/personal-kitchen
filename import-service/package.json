{
  "name": "personal-kitchen-import-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "私人厨房 V1 公开菜谱链接解析服务",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "typecheck:gateway": "tsc -p tsconfig.gateway.json",
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.56.1",
    "cheerio": "^1.1.2",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
